{
  "paper": "ar-spectrum-eegmmidb",
  "artifacts_root": ".",
  "manuscript": [
    "report.md"
  ],
  "whitelist_regex": [],
  "claims": [
    {
      "id": "ar_peak_hz",
      "statement": "AR parametric spectrum peak frequency (Hz) -- the alpha rhythm",
      "artifact": "benchmark_table.csv",
      "lookup": {
        "key_col": "metric",
        "key": "ar_peak_hz",
        "val_col": "value"
      },
      "expect": 10.9018,
      "tol": 0.01,
      "render": [
        "10.9 Hz"
      ]
    },
    {
      "id": "max_rel_diff_specar",
      "statement": "max |arSpectrum - stats::spec.ar| / spec.ar over all frequencies (bit-exact)",
      "artifact": "benchmark_table.csv",
      "lookup": {
        "key_col": "metric",
        "key": "max_rel_diff_specar",
        "val_col": "value"
      },
      "expect": 0,
      "tol": 1e-09,
      "render": [
        "5e-14"
      ]
    },
    {
      "id": "n_freq",
      "statement": "number of frequency bins in the AR spectrum",
      "artifact": "benchmark_table.csv",
      "lookup": {
        "key_col": "metric",
        "key": "n_freq",
        "val_col": "value"
      },
      "expect": 500,
      "tol": 0.5,
      "render": [
        "500"
      ]
    },
    {
      "id": "peak_in_alpha",
      "statement": "the AR spectral peak falls in the alpha band (8-13 Hz; 1 = yes)",
      "artifact": "benchmark_table.csv",
      "lookup": {
        "key_col": "metric",
        "key": "peak_in_alpha",
        "val_col": "value"
      },
      "expect": 1,
      "tol": 0.5,
      "render": [
        "yes"
      ]
    },
    {
      "id": "periodogram_peak_hz",
      "statement": "nonparametric smoothed-periodogram peak frequency (Hz)",
      "artifact": "benchmark_table.csv",
      "lookup": {
        "key_col": "metric",
        "key": "periodogram_peak_hz",
        "val_col": "value"
      },
      "expect": 11.4,
      "tol": 0.01,
      "render": [
        "11.4 Hz"
      ]
    },
    {
      "id": "cross_method_peak_diff_hz",
      "statement": "|AR peak - periodogram peak| -- parametric/nonparametric agreement (~0.5 Hz)",
      "artifact": "benchmark_table.csv",
      "lookup": {
        "key_col": "metric",
        "key": "cross_method_peak_diff_hz",
        "val_col": "value"
      },
      "expect": 0.4982,
      "tol": 0.01,
      "render": [
        "0.5 Hz"
      ]
    }
  ]
